#!/usr/bin/env python3
"""oc-secret-save: the one way an agent stores a new credential.

    oc-secret-save <name> <<'EOF'
    <the value>
    EOF

Reads the value from stdin (never from the command line, so it stays out of
the process list) and writes it to ~/.openclaw/secrets/<name> with mode 600.
It prints the path and size only, never the value.

The secrets folder is protected from direct writes, so an agent cannot damage
the team's own credentials. This tool only adds:
  - a new name is created;
  - the same value again is a no-op;
  - a different value replaces the file only if this tool saved it before
    (the old value is kept in .backups/); files the owner or the team put
    there are never overwritten: save under a new name instead.

$OC_SECRETS_DIR overrides the folder (tests).
"""
import datetime
import fcntl
import os
import re
import sys

NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$")
MAX_BYTES = 64 * 1024
LEDGER = ".saved-by-oc-secret-save"


def secrets_dir():
    return os.environ.get("OC_SECRETS_DIR") or os.path.expanduser("~/.openclaw/secrets")


def fail(msg, code=2):
    print(f"oc-secret-save: {msg}", file=sys.stderr)
    sys.exit(code)


def write_new(path, data):
    """Write data to a temp file beside path (mode 600), then move it into place."""
    tmp = f"{path}.tmp-{os.getpid()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        os.write(fd, data)
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(tmp, path)


def main(argv):
    if len(argv) != 1 or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if argv and argv[0] in ("-h", "--help") else 2
    name = argv[0]
    if not NAME.match(name) or ".." in name or name.endswith((".tmp", ".bak")) or name == LEDGER:
        fail(f"bad name {name!r}: use letters, digits, '.', '_' or '-' (for example telegram-mybot.token)")
    if sys.stdin.isatty():
        fail("give the value on stdin, for example with a heredoc: oc-secret-save NAME <<'EOF' ... EOF")
    data = sys.stdin.buffer.read(MAX_BYTES + 1)
    if len(data) > MAX_BYTES:
        fail(f"value is larger than {MAX_BYTES} bytes")
    value = data.rstrip(b"\r\n")
    if not value.strip():
        fail("the value is empty; nothing saved")
    data = value + b"\n"

    folder = secrets_dir()
    os.makedirs(folder, mode=0o700, exist_ok=True)
    path = os.path.join(folder, name)
    ledger_path = os.path.join(folder, LEDGER)
    with open(os.path.join(folder, ".oc-secret-save.lock"), "a") as lock:
        os.chmod(lock.name, 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            with open(ledger_path) as f:
                ours = {line.strip() for line in f if line.strip()}
        except FileNotFoundError:
            ours = set()
        if os.path.islink(path) or (os.path.exists(path) and not os.path.isfile(path)):
            fail(f"{path} exists and is not a plain file; nothing saved")
        if os.path.exists(path):
            with open(path, "rb") as f:
                if f.read().rstrip(b"\r\n") == value:
                    print(f"unchanged: {path} already holds this value")
                    return 0
            if name not in ours:
                fail(f"{path} already exists and was not saved by this tool, so it is not replaced. "
                     f"Save under a new name (for example {name}-2) or ask the owner.", 3)
            backups = os.path.join(folder, ".backups")
            os.makedirs(backups, mode=0o700, exist_ok=True)
            stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
            with open(path, "rb") as f:
                write_new(os.path.join(backups, f"{name}.{stamp}"), f.read())
            action = "replaced (old value kept in .backups/)"
        else:
            action = "saved"
        write_new(path, data)
        if name not in ours:
            with open(ledger_path, "a") as f:
                f.write(name + "\n")
            os.chmod(ledger_path, 0o600)
    print(f"{action}: {path} ({len(value)} bytes, mode 600). Use it from the file; never print it.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
