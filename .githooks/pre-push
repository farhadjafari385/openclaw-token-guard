#!/usr/bin/env bash
# Refuse to push secrets or the owner's private identifiers.
# Secret patterns are built in; private identifiers come from a local file that is never committed:
# Only commit:file:line is printed, never the matched text: the hook must not leak what it catches.
#   ~/.config/openclaw-privacy-patterns  (one regex per line, # comments)
set -u
SECRET='ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|glpat-[A-Za-z0-9_-]{10,}|sk-[A-Za-z0-9]{20,}|[0-9]{8,10}:AA[A-Za-z0-9_-]{30,}|BEGIN [A-Z ]*PRIVATE KEY|xox[bp]-[A-Za-z0-9-]+|AKIA[0-9A-Z]{16}'
PRIVATE_FILE="${OPENCLAW_PRIVACY_PATTERNS:-$HOME/.config/openclaw-privacy-patterns}"
PRIVATE=""
[ -f "$PRIVATE_FILE" ] && PRIVATE=$(grep -vE '^\s*(#|$)' "$PRIVATE_FILE" | paste -sd'|' -)
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  # A new branch, or a force-push whose old commit is not here (a rewrite): check everything the push carries.
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  commits=$(git rev-list "$range") || { echo "pre-push: cannot list the commits in $range: push refused (fail closed)."; exit 1; }
  for c in $commits; do
    if git grep -nI -E "$SECRET" "$c" -- . >/dev/null 2>&1; then echo "pre-push: secret-like value in $c:"; git grep -nI -E "$SECRET" "$c" -- . | cut -d: -f1-3 | head -5; fail=1; fi
    if [ -n "$PRIVATE" ] && git grep -nIi -E "$PRIVATE" "$c" -- . >/dev/null 2>&1; then echo "pre-push: private identifier in $c:"; git grep -nIi -E "$PRIVATE" "$c" -- . | cut -d: -f1-3 | head -5; fail=1; fi
    if git log -1 --format=%B "$c" | grep -qE "$SECRET" || { [ -n "$PRIVATE" ] && git log -1 --format=%B "$c" | grep -qiE "$PRIVATE"; }; then echo "pre-push: secret or private identifier in the message of $c"; fail=1; fi
  done
done
[ "$fail" = 0 ] || { echo "pre-push: push refused. Remove the data (and rewrite the commits) first."; exit 1; }

# Mirror of .github/workflows/test.yml (job "test"): gitleaks over the whole history, then the full suite.
# Needs gitleaks, node and python3 on PATH (the workflow installs the same).
export PATH="$HOME/.local/bin:$PATH"
root=$(git rev-parse --show-toplevel)
command -v gitleaks >/dev/null || { echo "pre-push: gitleaks not installed (the CI job runs it)" >&2; exit 1; }
(cd "$root" && gitleaks git --no-banner --redact .) || { echo "pre-push: BLOCKED (gitleaks found a secret in history)" >&2; exit 1; }
(cd "$root" && bash tests/run-all.sh) || { echo "pre-push: BLOCKED (tests/run-all.sh failed)" >&2; exit 1; }
echo "pre-push: all local CI checks passed"
