{
  "id": "token-guard",
  "name": "Token Guard",
  "description": "Enforces the team's rules on every tool call (protected rules/config, no back channels, orchestrator-only, spawn policy, budgets), follows every task to the end (anti-stall), mirrors team work into Telegram, and adds a task inbox.",
  "categories": [
    "developer-tools"
  ],
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "task_inbox",
      "wake_orchestrator"
    ]
  },
  "toolMetadata": {
    "task_inbox": {
      "optional": true,
      "sideEffecting": true
    },
    "wake_orchestrator": {
      "optional": false,
      "sideEffecting": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "dedupeWindowMs": {
        "type": "integer",
        "minimum": 0
      },
      "mode": {
        "type": "string",
        "enum": [
          "enforce",
          "warn"
        ]
      },
      "maxPollsPerJob": {
        "type": "integer",
        "minimum": 0
      },
      "maxPollsPerRun": {
        "type": "integer",
        "minimum": 0
      },
      "subagentMaxPollsPerRun": {
        "type": "integer",
        "minimum": 0
      },
      "maxForegroundSleepSeconds": {
        "type": "number",
        "minimum": 0
      },
      "maxBackgroundSleepSeconds": {
        "type": "number",
        "minimum": 0
      },
      "minLoopSleepSeconds": {
        "type": "number",
        "minimum": 0
      },
      "maxRepeatCommand": {
        "type": "integer",
        "minimum": 2
      },
      "maxRepeatMessage": {
        "type": "integer",
        "minimum": 2
      },
      "checkpointEvery": {
        "type": "integer",
        "minimum": 0
      },
      "maxToolCallsPerRun": {
        "type": "integer",
        "minimum": 1
      },
      "maxStatusChecksPerRun": {
        "type": "integer",
        "minimum": 0
      },
      "statusExemptSessionPatterns": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "briefMinChars": {
        "type": "integer",
        "minimum": 0
      },
      "requireBriefFields": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "briefCheckAgents": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "exemptSessionPatterns": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "runIdleResetMs": {
        "type": "integer",
        "minimum": 0
      },
      "ttlMs": {
        "type": "integer",
        "minimum": 60000
      },
      "maxTrackedRuns": {
        "type": "integer",
        "minimum": 10
      },
      "protect": {
        "type": "object",
        "additionalProperties": true
      },
      "backChannels": {
        "type": "object",
        "additionalProperties": true
      },
      "orchestratorOnly": {
        "type": "object",
        "additionalProperties": true
      },
      "pins": {
        "type": "object",
        "additionalProperties": true
      },
      "spawn": {
        "type": "object",
        "additionalProperties": true
      },
      "mirror": {
        "type": "object",
        "additionalProperties": true
      },
      "jobs": {
        "type": "object",
        "additionalProperties": true
      },
      "orchestratorAgent": {
        "type": "string"
      },
      "requireChecksBeforePush": {
        "type": "boolean",
        "description": "A task may push only after running its project's pipeline steps locally (lint, typecheck, tests, security, build)."
      },
      "wake": {
        "type": "object",
        "additionalProperties": false,
        "description": "Agents waking the orchestrator with the wake_orchestrator tool.",
        "properties": {
          "perAgentMinutes": { "type": "integer", "minimum": 1 },
          "perHour": { "type": "integer", "minimum": 1 },
          "maxChars": { "type": "integer", "minimum": 50 }
        }
      },
      "orchestratorMaxCallsPerRun": {
        "type": "integer",
        "minimum": 0,
        "description": "Tool calls one orchestrator run may make; after that only a message to the owner is allowed (0 = no limit)."
      },
      "workspaceRoot": {
        "type": "string"
      },
      "forbiddenModelPatterns": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "forbiddenThinking": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "maxBlockedRetries": {
        "type": "integer",
        "minimum": 0
      },
      "maxItemsPerBrief": {
        "type": "integer",
        "minimum": 1
      },
      "requireSpawnForBriefs": {
        "type": "boolean"
      },
      "projects": {
        "type": "object",
        "additionalProperties": true
      },
      "graphs": {
        "type": "object",
        "additionalProperties": true
      },
      "topics": {
        "type": "object",
        "additionalProperties": true
      },
      "board": {
        "type": "object",
        "additionalProperties": true
      },
      "taskPaths": {
        "type": "object",
        "additionalProperties": true
      },
      "ownerId": {
        "type": "string"
      },
      "triage": {
        "type": "object",
        "additionalProperties": true,
        "description": "10-minute Haiku triage: enabled, everyMinutes, model, orchestratorQuietMinutes"
      },
      "skills": {
        "type": "object",
        "additionalProperties": true,
        "description": "Per agent: [{name, about, always}] skill catalog used to name the right skills in each brief"
      }
    }
  }
}
